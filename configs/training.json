{
  "seed": 42,
  "fit_fraction_of_train": 0.8,
  "cv_splits": 3,
  "cv_gap": 0,
  "search_n_jobs": 2,
  "threshold": 0.5,
  "refit_metric": "ap",
  "permutation_repeats": 10,
  "random_forest": {
    "fixed": {"criterion": "gini", "bootstrap": true, "min_samples_split": 2, "n_jobs": 1},
    "grid": {
      "model__n_estimators": [150, 300],
      "model__max_depth": [null, 10],
      "model__min_samples_leaf": [1, 4],
      "model__max_features": ["sqrt", 1.0],
      "model__class_weight": [null, "balanced"]
    }
  },
  "xgboost": {
    "fixed": {"objective": "binary:logistic", "eval_metric": "logloss", "tree_method": "hist", "subsample": 0.8, "colsample_bytree": 0.9, "reg_alpha": 0, "reg_lambda": 1, "n_jobs": 1},
    "grid": {
      "model__n_estimators": [150, 300],
      "model__max_depth": [2, 4],
      "model__learning_rate": [0.05, 0.15],
      "model__min_child_weight": [1, 5],
      "model__scale_pos_weight": [1, 10]
    }
  }
}
